# Puerto del API
PORT=3001

# Contraseña del panel /api/admin (mínimo 16 caracteres, distinta de la del foro)
ADMIN_PASSWORD=change-me-with-a-long-random-password

# Admin inicial del foro (solo se crea si no existe)
FORUM_ADMIN_USERNAME=admin
FORUM_ADMIN_PASSWORD=change-me-with-a-long-random-password

# Orígenes CORS separados por comas (sin comodines en producción)
CORS_ORIGINS=

# Entorno
NODE_ENV=production
